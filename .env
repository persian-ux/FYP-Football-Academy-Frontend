# Use empty base URL so requests go through the Vite dev proxy (/api -> http://127.0.0.1:8000)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Live Football & World Cup Free APIs
# TheSportsDB public free developer key is "3" (no registration required)
VITE_THESPORTSDB_KEY=3
# Optional: RSS2JSON key if you exceed public rate limit (free tier available at rss2json.com)
# VITE_RSS2JSON_KEY=